# Copy this file to .env and fill in the key for the provider you use.
# Provider used by the chat assistant: groq (default), gemini or openrouter
LLM_PROVIDER=groq

GROQ_API_KEY=
GENAI_API_KEY=
OPENROUTER_API_KEY_1ST=

# Optional. Leave empty to use a local SQLite file (data/acms.db).
# DB_URL=postgresql+psycopg2://user:password@localhost:5432/acms

# Optional: free OpenRouter model for competitor price extraction (regex fallback if empty)
# OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free
